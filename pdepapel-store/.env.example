# Variables públicas de analítica y publicidad de la tienda (sin valores reales).
# Las de Production se configuran en Vercel; nunca en Preview ni Development.
# Ver lib/env.mjs y AGENTS.md › Analytics and privacy.

# GA4 (obligatoria en Production)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity (obligatorias en Production)
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_CLARITY_ENABLED=false
# Píxel de TikTok (opcional, solo Production, variable normal). Sin ella el
# píxel no carga; con ella solo carga tras el «sí» de «Publicidad».
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Cloudflare Turnstile (opcional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
