{
  "name": "pdepapel-admin",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "ts-node prisma/seed/index.ts"
  },
  "scripts": {
    "dev": "next dev",
    "email:dev": "email dev -p 3001 -d ./emails",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:push": "node scripts/with-test-env.mjs npx prisma db push --skip-generate",
    "test:integration": "node scripts/with-test-env.mjs npx vitest run --config vitest.integration.config.mts",
    "test:integration:watch": "node scripts/with-test-env.mjs npx vitest --config vitest.integration.config.mts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:e2e": "node scripts/with-e2e-env.mjs npx playwright test",
    "test:e2e:seed-admin": "node scripts/with-e2e-env.mjs node scripts/with-test-env.mjs tsx scripts/seed-e2e-admin-store.ts",
    "test:e2e:admin": "E2E_REQUIRE_CLERK=1 node scripts/with-e2e-env.mjs npx playwright test tests/e2e/authenticated-smoke.spec.ts",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "format:prettier": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "export:products": "tsx prisma/utils/products-to-csv.ts",
    "export:products-merchant": "tsx prisma/utils/products-to-google-merchant.ts",
    "normalize:product-slugs": "tsx scripts/normalize-product-slugs.ts",
    "update:orders": "ts-node prisma/scripts/update-orders-totals.ts",
    "cleanup:orphaned-shipments": "ts-node scripts/cleanup-orphaned-shipments.ts",
    "seed:boxes": "ts-node prisma/seed/seed-boxes.ts"
  },
  "dependencies": {
