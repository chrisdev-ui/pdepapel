  @@unique([fairEventId, productId])
  @@index([productId])
}

model FairCapsule {
  id               String            @id @default(uuid())
  fairEventId      String
  productId        String
  orderItemId      String?           @unique
  code             String            @unique
  salePrice        Float
  productCost      Float
  minimumMarginPct Float
  status           FairCapsuleStatus @default(PACKED)
  packedAt         DateTime          @default(now())
  soldAt           DateTime?
  voidedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  fairEvent FairEvent  @relation(fields: [fairEventId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([fairEventId, status])
  @@index([productId])
}

enum InventoryMovementType {
  ORDER_PLACED // Decrease
  ORDER_CANCELLED // Increase (Restock)
  MANUAL_ADJUSTMENT // Increase/Decrease
  INITIAL_MIGRATION // Increase
  RETURN // Increase
  DAMAGE // Decrease
  LOST // Decrease
  PROMOTION // Decrease
  PURCHASE // Increase (Buying stock from supplier)
  INITIAL_INTAKE // First-time stock entry
  RESTOCK_RECEIVED // Supplier restock
  STORE_USE // Internal store consumption
  FESTIVAL_ALLOCATION // Removed from online availability
  FESTIVAL_RETURN // Returned to online availability
  IN_PERSON_SALE // Decrease from a confirmed in-person sale
  VARIANT_CONVERSION // Reparto del stock de un producto suelto entre sus variantes nuevas
  CAPSULE_PACKED // Empaque de cápsulas: salida en los productos de origen, entrada en la cápsula
  CAPSULE_UNPACKED // Deshacer un empaque: la cápsula vuelve a ser sus productos de origen
}

enum FairEventStatus {
  DRAFT
  OPEN
  RECONCILING
  CLOSED
  CANCELLED
}

enum FairCapsuleStatus {
  PACKED
  SOLD
  VOID
}

model RestockOrder {
  id           String             @id @default(uuid())
  storeId      String
  supplierId   String
  orderNumber  String // Auto-generated e.g., PO-1001
  status       RestockOrderStatus @default(DRAFT)
  totalAmount  Float              @default(0) // Expected total cost
  shippingCost Float              @default(0) // Extra logistics cost to distribute
  notes        String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  store    Store                 @relation("StoreToRestockOrder", fields: [storeId], references: [id])
  supplier Supplier              @relation(fields: [supplierId], references: [id])
  items    RestockOrderItem[]
  receipts RestockOrderReceipt[]

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([supplierId])
  @@index([status])
}

model RestockOrderItem {
  id               String @id @default(uuid())
  restockOrderId   String
  productId        String
  index            Int    @default(0)
  quantity         Int // Ordered quantity
  quantityReceived Int    @default(0) // Track received amount
  cost             Float // Unit cost agreed
  subtotal         Float // quantity * cost

  restockOrder RestockOrder @relation(fields: [restockOrderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([restockOrderId])
  @@index([productId])
}

/// Una recepción de mercancía: qué llegó, cuándo y con qué costo puesto en
/// bodega. La clave de idempotencia la genera el diálogo al abrirse, así un
/// reintento tras una respuesta lenta no vuelve a sumar stock.
model RestockOrderReceipt {
  id             String   @id @default(uuid())
  storeId        String
  restockOrderId String
  idempotencyKey String   @db.VarChar(64)
  receivedUnits  Int
  lineCount      Int
  excessUnits    Int      @default(0)
  updatedCosts   Boolean  @default(false)
  /// [{ restockOrderItemId, productId, quantity, excess, unitCost, landedUnitCost }]
  lines          Json
  createdBy      String?
  createdAt      DateTime @default(now())

  restockOrder RestockOrder @relation(fields: [restockOrderId], references: [id], onDelete: Cascade)
  store        Store        @relation("StoreToRestockOrderReceipt", fields: [storeId], references: [id])

  @@unique([restockOrderId, idempotencyKey])
  @@index([storeId])
  @@index([restockOrderId])
}

enum RestockOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

// Las cotizaciones por plantilla, los pedidos personalizados (CustomOrder) y
// los mensajes/plantillas de WhatsApp se retiraron el 2026-09-12; sus tablas
