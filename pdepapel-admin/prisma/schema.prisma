  status                ShippingStatus          @default(Preparing)
  provider              ShippingProvider        @default(MANUAL)
  boxId                 String?
  /// Una caja con envíos no se borra (Restrict emulado por Prisma): la API lo
  /// rechaza con 409 y el cliente de Prisma también, así ningún script la deja huérfana.
  box                   Box?                    @relation(fields: [boxId], references: [id], onDelete: Restrict)
  envioClickIdRate      Int? // ⭐ idRate de cotización (guardado al cotizar)
  envioClickIdOrder     Int? // ⭐ idOrder de guía (retornado al crear guía)
  myShipmentReference   String? // Referencia de tu sistema (orderNumber)
  externalOrderId       String? // ID externo adicional
  carrierId             Int? // idCarrier de EnvioClick
  carrierName           String? // Nombre: "COORDINADORA", "ENVIA", etc.
  productId             Int? // idProduct de EnvioClick
  productName           String? // "Normal", "Normal COD", etc.
  flete                 Float? // Costo base de envío
  minimumInsurance      Float? // Seguro obligatorio
  extraInsurance        Float? // Seguro extra
  hasInsurance          Boolean                 @default(false)
  isCOD                 Boolean                 @default(false)
  codValue              Float? // Valor a recaudar
  codCost               Float? // Costo adicional por COD
  includeGuideCost      Boolean                 @default(false)
  codPaymentMethod      String? // "cash" | "data_phone"
  trackingCode          String? // tracker de EnvioClick
  trackingUrl           String? // URL de tracking (si existe)
  guideUrl              String? // URL del PDF de guía (S3)
  guidePdfBase64        String?                 @db.LongText // PDF en base64 (opcional)
  requestPickup         Boolean                 @default(false)
  pickupDate            DateTime?
  quotationData         Json?
  originData            Json? // Datos completos de origen
  destinationData       Json? // Datos completos de destino
  deliveryDays          Int? // Días estimados de EnvioClick
  estimatedDeliveryDate DateTime?
  actualDeliveryDate    DateTime?
  notes                 String?                 @db.Text
  courier               String?
  cost                  Float?
  /// Último intento fallido de crear la guía en EnvioClick (mensaje y momento).
  /// Se limpia cuando la guía se crea. Sin esto el pedido se quedaba en
  /// «Por despachar» sin decir por qué.
  guideError            String?                 @db.Text
  guideAttemptedAt      DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  storeId               String
  store                 Store                   @relation("StoreToShipping", fields: [storeId], references: [id])
  order                 Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingEvents        ShippingTrackingEvent[]

