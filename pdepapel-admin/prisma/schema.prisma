  store Store? @relation(fields: [storeId], references: [id])

  @@unique([name, storeId])
  @@index([storeId])
  @@index([ranAt])
}

/// Webhook de EnvioClick que llegó sin un envío que lo reclame. Antes se
/// respondía 200 y el evento se perdía; ahora queda guardado para revisarlo.
model ShippingWebhookEvent {
  id                  String    @id @default(uuid())
  storeId             String?
  provider            String    @default("ENVIOCLICK")
  idOrder             String?
  myShipmentReference String?
  payload             Json
  reason              String
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?

  store Store? @relation(fields: [storeId], references: [id])

  @@index([storeId, resolvedAt])
  @@index([idOrder])
  @@index([myShipmentReference])
}

/// Cada llamada de Bold o Wompi al webhook de pagos, incluidas las rechazadas.
/// Se escribe antes de verificar la firma, así que una clave rotada o un monto
/// que no cuadra dejan rastro en vez de un `console.warn` que se pierde.
model PaymentWebhookEvent {
  id             String                    @id @default(uuid())
  storeId        String?
  provider       PaymentWebhookProvider
  eventType      String?
  transactionId  String?
  orderReference String?
  orderId        String?
  statusCode     Int?
  status         PaymentWebhookEventStatus @default(RECEIVED)
  rawBody        String                    @db.Text
  signature      String?
  payload        Json?
  error          String?                   @db.Text
  createdAt      DateTime                  @default(now())
  completedAt    DateTime?

  store Store? @relation(fields: [storeId], references: [id])

  @@index([storeId, status, createdAt])
  @@index([provider, transactionId])
  @@index([orderId])
  @@index([status, completedAt])
}

/// Vinculación de un celular como escáner remoto de una pantalla del panel
/// (2026-09-19). Un código corto por sesión; vence a los 10 minutos sin
/// actividad y cada lectura lo renueva. Solo un celular a la vez: volver a
/// vincular cambia el token y el anterior deja de poder enviar.
model ScannerSession {
  id              String    @id @default(uuid())
  storeId         String
  code            String
  createdByUserId String
  pairedUserId    String?
  pairingToken    String?
  deviceLabel     String?
  pairedAt        DateTime?
  lastActivityAt  DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  store Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  scans ScannerScan[]

  @@unique([storeId, code])
  @@index([storeId, expiresAt])
}

/// Cada código leído por el celular vinculado; la pantalla los recoge por
/// `createdAt` mayor que el último que vio.
model ScannerScan {
  id        String   @id @default(uuid())
  sessionId String
  code      String
  createdAt DateTime @default(now())

  session ScannerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model InventoryMovement {
  id            String                @id @default(uuid())
  storeId       String
  productId     String
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          InventoryMovementType
  quantity      Int // Positive = Add, Negative = Remove
  previousStock Int // Snapshot
  newStock      Int // Snapshot
  cost          Float? // Unit cost at this moment
  price         Float? // Unit sell price (if applicable)
  reason        String?
  description   String?               @db.Text
  referenceId   String? // Order ID, etc.
  createdAt     DateTime              @default(now())
  createdBy     String? // User ID or System

  store Store @relation("StoreToInventoryMovement", fields: [storeId], references: [id])

  @@index([storeId])
  @@index([productId])
  @@index([createdAt])
  @@index([type])
}

model FairEvent {
  id        String          @id @default(uuid())
  storeId   String
  name      String
  location  String?
  startsAt  DateTime?
  endsAt    DateTime?
  status    FairEventStatus @default(DRAFT)
  notes     String?         @db.Text
  createdBy String?
  openedAt  DateTime?
  closedAt  DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  store          Store                    @relation(fields: [storeId], references: [id])
  inventoryItems FairEventInventoryItem[]
  orders         Order[]
