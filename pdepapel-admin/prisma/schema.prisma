/// Estado de una campaña de preventa de un producto.
enum ProductPresaleStatus {
  /// Se está vendiendo por adelantado. Es el único estado que reserva unidades.
  ACTIVE
  /// Llegó la mercancía y los pedidos ya salieron al despacho normal.
  RELEASED
  /// Se canceló sin llegar a liberarse.
  CANCELLED
}

/// Campaña de preventa: vender un producto antes de tenerlo en bodega.
///
/// Vive aparte de `Product` para guardar historia: un producto puede hacer
/// varias preventas a lo largo del tiempo y cada una tiene su fecha, su tope y
/// su registro de quién liberó o avisó un retraso.
///
/// No toca `Product.stock` nunca. Las unidades prometidas se llevan en
/// `committedUnits`, que solo se mira en la pantalla de Preventas: Inventario,
/// «Por reponer» y el kardex siguen leyendo únicamente el stock real.
model ProductPresale {
  id                String               @id @default(uuid())
  storeId           String
  productId         String
  status            ProductPresaleStatus @default(ACTIVE)
  /// Fecha que se le promete a la clienta. Pasada esta fecha sin liberar, la
  /// preventa está vencida.
  expectedArrivalAt DateTime
  /// Cuántas unidades se pueden prometer como máximo.
  unitLimit         Int
  /// Unidades ya reservadas. Se sube con el mismo candado atómico que el stock.
  committedUnits    Int                  @default(0)
  releasedAt        DateTime?
  releasedBy        String?
  /// Aviso de retraso: queda anotado por si una clienta reclama después.
  delayNotifiedAt   DateTime?
  delayNotifiedBy   String?
  createdBy         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  store   Store   @relation("StoreToProductPresale", fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([storeId, status, expectedArrivalAt])
  @@index([productId, status])
  @@index([storeId, productId])
}

enum OrderSource {
  PANEL
  STORE
  WHATSAPP
}

/// Un hilo con una clienta en un canal: una fila por (tienda, canal, teléfono normalizado).
model Conversation {
  id             String              @id @default(uuid())
  storeId        String
  channel        ConversationChannel @default(WHATSAPP)
  /// Solo dígitos con indicativo (`normalizePhone`), la misma llave que agrupa
  /// Clientes. **Puede faltar**: desde que Meta admite nombres de usuario, el
  /// webhook omite el teléfono de quien tiene uno salvo que haya habido trato
  /// en 30 días o esté en la libreta del negocio. Responderle no basta.
  phone          String?
  /// Identificador de Meta por negocio (BSUID, p. ej. `CO.2465629583926901`).
  /// Llega siempre, con teléfono o sin él, y es estable para un mismo contacto,
  /// así que es la identidad que no se pierde. `null` en las conversaciones
  /// anteriores a que esto existiera.
  bsuid          String?
  /// Nombre de usuario de WhatsApp (`@mrs_han14`), sin la arroba. Meta lo
  /// manda en `contacts[].profile.username` y muchas veces es lo ÚNICO legible
  /// que llega: `profile.name` viene vacío para la mayoría de estos contactos.
  username       String?
  contactName    String?
  status         ConversationStatus  @default(OPEN)
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  /// Último mensaje de Paula desde su propio celular (`fileOwnerEcho`). Es lo
  /// que frena al bot: `lastOutboundAt` no sirve porque lo mueven los dos.
  lastOwnerAt    DateTime?
  orderId        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  store    Store                 @relation("StoreToConversation", fields: [storeId], references: [id])
  order    Order?                @relation(fields: [orderId], references: [id])
  messages ConversationMessage[]

  @@unique([storeId, channel, phone])
  @@unique([storeId, channel, bsuid])
  @@index([storeId, status, lastInboundAt])
  @@index([orderId])
}

/// Respuestas automáticas de WhatsApp, editables desde el panel: la dueña
/// define aquí qué contesta el bot, sin tocar código.
model WhatsAppBotReply {
  id         String    @id @default(uuid())
  storeId    String
  /// Nombre corto con el que ella la reconoce («Horarios», «Envíos»).
  label      String
  /// Frases que disparan la respuesta, ya normalizadas (minúsculas, sin tildes).
  triggers   Json
  answer     String    @db.Text
  /// Apagarla la deja guardada sin que el bot la use.
  isActive   Boolean   @default(true)
  /// Gana la primera que coincida, así que el orden importa.
  sortOrder  Int       @default(0)
  /// Botones que se mandan con la respuesta: `[{ title, targetReplyId }]`.
  /// Máximo dos; el sistema siempre añade «Hablar con Paula» como último
  /// botón, así que nunca se guarda aquí.
  buttons    Json?
  /// Cuándo aprobó Paula este menú. Una respuesta CON botones no se manda
  /// hasta tenerlo, y editar el texto o los botones lo borra: así un cambio
  /// no puede colarse con la aprobación de la versión anterior.
  approvedAt DateTime?
  /// Clerk id de quien aprobó, para saber de quién fue el visto bueno.
  approvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  store Store @relation("StoreToWhatsAppBotReply", fields: [storeId], references: [id])

  @@index([storeId, isActive, sortOrder])
}

model ConversationMessage {
  id             String                       @id @default(uuid())
  conversationId String
  direction      ConversationMessageDirection
  /// `wamid` de Meta; único cuando existe, así un evento reintentado no duplica.
  externalId     String?                      @unique
  body           String?                      @db.Text
  mediaType      String?
  mediaUrl       String?
  sentBy         ConversationMessageSentBy
  status         ConversationMessageStatus    @default(RECEIVED)
  /// `MarketplaceWebhookEvent.id` del que salió; sin relación, solo trazabilidad.
  rawEventId     String?
  /// Datos estructurados que no caben en `body`. Hoy solo el carrito que manda
  /// una clienta desde el catálogo (`{ order: { catalogId, items: [...] } }`),
  /// guardado tal cual llega: los SKU se resuelven contra el catálogo al
  /// mostrarlo, para que precio y existencias sean los de ahora y no los del
  /// día que escribió.
  metadata       Json?
  createdAt      DateTime                     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

