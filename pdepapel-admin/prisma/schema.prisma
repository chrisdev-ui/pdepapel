  /// Fecha en que el cron diario vio que el archivo ya no existe; null si está bien.
  brokenAt       DateTime?

  @@index([productId])
  @@index([productGroupId])
  @@index([brokenAt])
}

model Order {
  id               String          @id @default(uuid())
  storeId          String
  email            String?         @default("")
  phone            String          @default("")
  address          String          @default("")
  address2         String?         @default("")
  city             String?         @default("")
  department       String?         @default("")
  daneCode         String?         @default("")
  neighborhood     String?         @default("") // suburb en EnvioClick
  addressReference String?         @default("") // reference en EnvioClick
  company          String?         @default("")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  orderNumber      String          @unique
  fullName         String          @default("")
  documentId       String?         @default("")
  status           OrderStatus     @default(CREATED)
  userId           String?         @default("")
  guestId          String?         @default("")
  subtotal         Float           @default(0)
  discount         Float           @default(0)
  discountType     DiscountType?
  discountReason   String?
  couponId         String?
  couponDiscount   Float           @default(0)
  total            Float           @default(0)
  coupon           Coupon?         @relation(fields: [couponId], references: [id])
  store            Store           @relation("StoreToOrder", fields: [storeId], references: [id])
  orderItems       OrderItem[]
  shipping         Shipping?
  payment          PaymentDetails?

  // -- UNIFIED ORDER FIELDS --
  type OrderType @default(STANDARD)

  // Workflow & Public Access
  token     String?   @unique // For public quote view
  expiresAt DateTime? // For quotations validity
  viewedAt  DateTime?
  paidAt    DateTime?

  // Analytics attribution is optional and is captured only after visitor consent.
  // The client ID is cleared once the server-side purchase event is confirmed.
  analyticsClientId          String?   @db.VarChar(128)
  analyticsPurchaseTrackedAt DateTime?
  // Sólo el sí o el no, para poder medir cuántas ventas pagadas quedan fuera
  // de GA4. De quien no acepta no se guarda nada más.
  analyticsConsent           Boolean?

  // -- BI Financial Fields --
  totalProductCost Float?
  gatewayFee       Float?
  shippingCost     Float?
  netProfit        Float?
  profitMarginPct  Float?

  // Custom/Manual Order Fields
  adminNotes     String? @db.Text
  internalNotes  String? @db.Text
  fairEventId    String?
  idempotencyKey String? @unique

  // Sender Info
  createdBy String? // Admin User ID
  /**
   * Canal que originó el pedido; `null` en los pedidos anteriores a 2026-09-13.
   */
  source    OrderSource?

  quoteRequests   QuoteRequest[]
  conversations   Conversation[]
  invoices        Invoice[]
  fairEvent       FairEvent?            @relation(fields: [fairEventId], references: [id])
  inventoryIssues OrderInventoryIssue[]

  @@index([storeId])
  @@index([couponId])
  @@index([storeId, status])
  @@index([userId, storeId])
  @@index([guestId, storeId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([storeId, status, createdAt])
  @@index([storeId, userId, status])
  @@index([storeId, total, status])
  @@index([storeId, createdAt, total])
  @@index([id, storeId, status])
  @@index([userId, guestId, storeId, createdAt])
  @@index([storeId, userId, createdAt])
  @@index([storeId, guestId, createdAt])
  @@index([token])
  @@index([type])
  @@index([storeId, fairEventId])
  @@index([analyticsPurchaseTrackedAt])
}

