/// Línea de inventario que no se pudo mover cuando el pedido cambió de estado
/// (pago confirmado, cancelación, borrado). El pedido siguió adelante; esta
/// fila es la deuda pendiente con el kardex hasta que alguien la reintenta o
/// la concilia a mano.
model OrderInventoryIssue {
  id          String                  @id @default(uuid())
  storeId     String
  /// Null cuando el pedido se borró después: la deuda con el kardex sigue viva.
  orderId     String?
  orderNumber String
  kind        OrderInventoryIssueKind
  productId   String
  productName String
  /// Unidades que faltaron por mover (siempre positivas; `kind` dice el sentido).
  quantity    Int
  reason      String                  @db.Text
  createdAt   DateTime                @default(now())
  resolvedAt  DateTime?
  /// Usuario que reintentó o concilió, o "SYSTEM" cuando el reintento fue automático.
  resolvedBy  String?
  /// Movimiento de inventario creado al reintentar con éxito.
  movementId  String?

  store Store  @relation(fields: [storeId], references: [id])
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([storeId, resolvedAt])
  @@index([orderId])
  @@index([productId])
}

enum OrderInventoryIssueKind {
  DECREMENT
  RESTOCK
}

/// Última ejecución de cada tarea programada o de fondo (crons, revalidación
/// de la tienda). Una fila por nombre: se sobreescribe en cada corrida.
/// Un aviso que no salió. Es el registro mínimo para poder responder «¿le
/// llegó el correo a esta clienta?»: no hay reintento automático todavía, así
/// que quien mire esta tabla es quien lo resuelve a mano.
model FailedNotification {
  id         String    @id @default(uuid())
  storeId    String?
  /// EMAIL | WHATSAPP
  channel    String
  /// Para qué era: confirmación de pedido, aviso de envío, retraso de preventa…
  kind       String
  /// A quién se intentaba llegar (correo o teléfono), para poder buscarlo.
  recipient  String?
  /// Pedido relacionado, cuando lo hay.
  orderId    String?
  error      String    @db.Text
  createdAt  DateTime  @default(now())
  /// Cuando alguien ya lo resolvió a mano.
  resolvedAt DateTime?

  store Store? @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@index([orderId])
  @@index([resolvedAt])
}

/// Datos del negocio que la dueña edita desde Configuración.
///
/// Existe para que estas respuestas dejen de estar repartidas entre el pie de
/// página de la tienda y constantes del código: el bot y el sitio tienen que
/// decir lo mismo, y para cambiar un horario no debería hacer falta desplegar.
///
/// Ojo con `cityName`: es la ciudad del NEGOCIO, no el origen de los envíos.
/// El origen vive en `constants/shipping.ts` (`STORE_SHIPPING_INFO`) porque es
/// lo que se le manda a la transportadora. Hoy coinciden; son cosas distintas.
model StoreSettings {
  id      String @id @default(uuid())
  storeId String @unique

  /// Atención a toda hora. Cuando está en true el horario por día no se mira:
  /// el horario describe cuándo contesta Paula, y el bot cubre el resto.
  alwaysOpen                Boolean          @default(false)
  /// Horario por día: { "lun": { "abre": "08:00", "cierra": "20:00" }, … }.
  /// Un día ausente o null significa cerrado.
  openingHours              Json?
  cityName                  String?
  hasPhysicalStore          Boolean          @default(false)
  physicalAddress           String?
  minOrderRule              MinimumOrderRule @default(NONE)
  /// Solo se usa con la regla FIXED.
  minOrderAmount            Int?
  /// Subtotal desde el cual el envío es gratis; lo que el bot responde a la
  /// pregunta general de envíos sin tener que cotizar.
  freeShippingThreshold     Int?
  /// Cuánto tarda en llegar un pedido, tal como se le dice a la clienta
  /// («2 a 4 días hábiles»). Único sitio: la tienda y el bot leen de aquí.
  deliveryEstimate          String?
  /// Las formas de pago, una por campo. Separadas y no un solo texto porque el
  /// bot las ofrece en un menú: cada una es una opción que se toca, y cada
  /// opción enseña SOLO lo suyo. Vacía significa «esa no la ofrecemos», y el
  /// menú ni la muestra.
  /// Efectivo: la nota humana; la dirección ya vive en `physicalAddress`.
  paymentCashInfo           String?          @db.Text
  /// La cuenta de ahorros, tal como se le dicta a una clienta.
  paymentBancolombiaAccount String?          @db.Text
  paymentNequiNumber        String?          @db.Text
  paymentDaviplataNumber    String?          @db.Text
  /// El datáfono (Bold): qué tarjetas, si hay recargo, dónde se usa.
  paymentCardInfo           String?          @db.Text
  /// Apaga el bot sin borrar sus respuestas. Apagado por defecto a propósito:
  /// se enciende cuando alguien lo decide, no por crear la fila.
  botEnabled                Boolean          @default(false)

  /// Visto bueno de Paula a los textos con los que el bot contesta los datos
  /// del negocio. `botFactsVersion` guarda la versión aprobada: si se edita
  /// un texto en el código la versión cambia y la aprobación deja de valer,
  /// igual que editar una respuesta borra su `approvedAt`.
  botFactsApprovedAt DateTime?
  botFactsApprovedBy String?
  botFactsVersion    String?

  /// Lo mismo, pero para las respuestas sobre productos. Va aparte del visto
  /// bueno de los datos del negocio a propósito: si compartieran versión,
  /// añadir respuestas nuevas retiraría sin querer la aprobación de las viejas.
  botProductsApprovedAt DateTime?
  botProductsApprovedBy String?
  botProductsVersion    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

/// Cómo se sugiere un pedido mínimo. MATCH_SHIPPING es la regla de la casa:
/// que el pedido valga al menos lo que cuesta el envío. Es sugerencia, nunca
/// un bloqueo.
enum MinimumOrderRule {
  NONE
  MATCH_SHIPPING
  FIXED
}

model JobRun {
