generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Store {
  id                             String                          @id @default(uuid())
  name                           String
  userId                         String
  logoUrl                        String?
  phone                          String?                         @default("")
  email                          String?                         @default("")
  address                        String?                         @default("")
  instagram                      String?                         @default("")
  tiktok                         String?                         @default("")
  youtube                        String?                         @default("")
  facebook                       String?                         @default("")
  twitter                        String?                         @default("")
  pinterest                      String?                         @default("")
  policies                       Json?                           @default("{}")
  daneCode                       String?                         @default("")
  neighborhood                   String?                         @default("")
  addressReference               String?                         @default("")
  contactName                    String?                         @default("")
  defaultPackageWeight           Float?                          @default(1.0) // Peso por defecto (kg)
  defaultPackageHeight           Float?                          @default(10.0) // Alto por defecto (cm)
  defaultPackageWidth            Float?                          @default(10.0) // Ancho por defecto (cm)
  defaultPackageLength           Float?                          @default(10.0) // Largo por defecto (cm)
  freeShippingThreshold          Int? // Subtotal (COP) desde el cual el envío es gratis; null = desactivado
  lowStockThreshold              Int? // Unidades desde las cuales el stock se considera crítico; null = usa TRESHOLD_LOW_STOCK (5)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  types                          Type[]                          @relation("StoreToType")
  homeContents                   HomeContent[]                   @relation("StoreToHomeContent")
  posts                          Post[]                          @relation("StoreToPost")
  categories                     Category[]                      @relation("StoreToCategory")
  sizes                          Size[]                          @relation("StoreToSize")
  shippingProfiles               ShippingProfile[]
  catalogOptions                 CatalogOption[]
  catalogOptionValues            CatalogOptionValue[]
  categoryCatalogOptions         CategoryCatalogOption[]
  productCatalogOptionValues     ProductCatalogOptionValue[]
  catalogMigrationSuggestions    CatalogMigrationSuggestion[]
  colors                         Color[]                         @relation("StoreToColor")
  designs                        Design[]                        @relation("StoreToDesign")
  products                       Product[]                       @relation("StoreToProduct")
  productSlugAliases             ProductSlugAlias[]
  categorySlugAliases            CategorySlugAlias[]
  typeSlugAliases                TypeSlugAlias[]
  orders                         Order[]                         @relation("StoreToOrder")
  reviews                        Review[]                        @relation("StoreToReview")
  shippings                      Shipping[]                      @relation("StoreToShipping")
  payments                       PaymentDetails[]                @relation("StoreToPaymentDetails")
  suppliers                      Supplier[]                      @relation("StoreToSupplier")
  coupons                        Coupon[]                        @relation("StoreToCoupons")
  customerAddresses              CustomerAddress[]               @relation("StoreToCustomerAddress")
  customerWishlistItems          CustomerWishlistItem[]          @relation("StoreToCustomerWishlistItem")
  customerSavedSearches          CustomerSavedSearch[]           @relation("StoreToCustomerSavedSearch")
  couponRedemptions              CouponRedemption[]              @relation("StoreToCouponRedemption")
  shippingQuotes                 ShippingQuote[]                 @relation("StoreToShippingQuotes")
  offers                         Offer[]                         @relation("StoreToOffer")
  boxes                          Box[]                           @relation("StoreToBox")
  productGroups                  ProductGroup[]                  @relation("StoreToProductGroup")
  inventoryMovements             InventoryMovement[]             @relation("StoreToInventoryMovement")
  restockOrders                  RestockOrder[]                  @relation("StoreToRestockOrder")
  restockOrderReceipts           RestockOrderReceipt[]           @relation("StoreToRestockOrderReceipt")
  quoteRequests                  QuoteRequest[]                  @relation("StoreToQuoteRequest")
  invoices                       Invoice[]                       @relation("StoreToInvoice")
  taxPurchases                   TaxPurchase[]                   @relation("StoreToTaxPurchase")
  customerReactivations          CustomerReactivation[]          @relation("StoreToCustomerReactivation")
  newsletterSubscribers          NewsletterSubscriber[]          @relation("StoreToNewsletterSubscriber")
  conversations                  Conversation[]                  @relation("StoreToConversation")
  whatsAppBotReplies             WhatsAppBotReply[]              @relation("StoreToWhatsAppBotReply")
  productPresales                ProductPresale[]                @relation("StoreToProductPresale")
  newsletterIssues               NewsletterIssue[]               @relation("StoreToNewsletterIssue")
  newsletterCampaignSends        NewsletterCampaignSend[]        @relation("StoreToNewsletterCampaignSend")
  fairEvents                     FairEvent[]
  capsuleBatches                 CapsuleBatch[]
  productPriceTiers              ProductPriceTier[]
  marketplaceConnections         MarketplaceConnection[]
  marketplaceOAuthStates         MarketplaceOAuthState[]
  marketplaceCategoryTemplates   MarketplaceCategoryTemplate[]
  marketplacePublicationProfiles MarketplacePublicationProfile[]
  productNamingChanges           ProductNamingChange[]
  businessCashPolicy             BusinessCashPolicy?
  businessCashMovements          BusinessCashMovement[]
  growthCampaigns                GrowthCampaign[]
  orderInventoryIssues           OrderInventoryIssue[]
  failedNotifications            FailedNotification[]
  settings                       StoreSettings?
  jobRuns                        JobRun[]
  shippingWebhookEvents          ShippingWebhookEvent[]
  paymentWebhookEvents           PaymentWebhookEvent[]
  scannerSessions                ScannerSession[]
}

model Offer {
  id        String       @id @default(uuid())
  storeId   String
  name      String // Internal name e.g. "Summer Sale"
  label     String? // Public label e.g. "20% OFF"
  type      DiscountType // PERCENTAGE | FIXED (Reuse existing enum)
  amount    Float // e.g. 20 for 20%, or 5000 for $5000 off
  startDate DateTime
  endDate   DateTime
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  store         Store               @relation("StoreToOffer", fields: [storeId], references: [id])
  products      OfferProduct[]
  categories    OfferCategory[]
  productGroups OfferProductGroup[]

  @@index([storeId])
  @@index([isActive, startDate, endDate])
}

model OfferProduct {
  id        String @id @default(uuid())
  offerId   String
  productId String

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([offerId, productId])
  @@index([productId])
}

model OfferCategory {
  id         String @id @default(uuid())
  offerId    String
  categoryId String

  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([offerId, categoryId])
  @@index([categoryId])
}

model OfferProductGroup {
  id             String @id @default(uuid())
  offerId        String
  productGroupId String

  offer        Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productGroup ProductGroup @relation(fields: [productGroupId], references: [id], onDelete: Cascade)

  @@unique([offerId, productGroupId])
  @@index([productGroupId])
}

model Post {
  id        String   @id @default(uuid())
  storeId   String
  social    Social
  postId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation("StoreToPost", fields: [storeId], references: [id])

  @@unique([storeId, social, postId])
  @@index([storeId])
}

model Type {
  id          String          @id @default(uuid())
  storeId     String
  name        String
  slug        String          @default("")
  /// Nombre de icono de Lucide (kebab-case) que pinta la tienda; el nombre nunca lleva emoji.
  icon        String?         @db.VarChar(32)
  /// Icono propio generado con IA en el estilo de Lucide: solo el contenido del <svg> (trazos), saneado al guardar.
  iconSvg     String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  isArchived  Boolean         @default(false)
  archivedAt  DateTime?
  store       Store           @relation("StoreToType", fields: [storeId], references: [id])
  categories  Category[]
  slugAliases TypeSlugAlias[]

  @@index([storeId])
  @@index([storeId, slug])
  @@index([storeId, isArchived])
}

model Category {
  id                             String                          @id @default(uuid())
  storeId                        String
  typeId                         String
  name                           String
  slug                           String                          @default("")
  icon                           String?                         @db.VarChar(32)
  seoEnabled                     Boolean                         @default(false)
  seoFeatured                    Boolean                         @default(false)
  seoTitle                       String?                         @db.VarChar(70)
  seoDescription                 String?                         @db.VarChar(170)
  seoIntro                       String?                         @db.Text
  imageUrl                       String?                         @db.Text
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  isArchived                     Boolean                         @default(false)
  archivedAt                     DateTime?
  store                          Store                           @relation("StoreToCategory", fields: [storeId], references: [id])
  type                           Type                            @relation(fields: [typeId], references: [id])
  products                       Product[]                       @relation("CategoryToProduct")
  offers                         OfferCategory[]
  slugAliases                    CategorySlugAlias[]
  catalogOptions                 CategoryCatalogOption[]
  marketplacePublicationProfiles MarketplacePublicationProfile[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([typeId])
  @@index([storeId, isArchived])
}

model Size {
  id         String    @id @default(uuid())
  storeId    String
  name       String
  value      String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  store      Store     @relation("StoreToSize", fields: [storeId], references: [id])
  products   Product[]

  @@unique([storeId, value])
  @@index([storeId])
  @@index([storeId, isArchived])
}

model ShippingProfile {
  id            String    @id @default(uuid())
  storeId       String
  name          String
  code          String
  dimensionCode String?   @db.VarChar(16)
  weightCode    String?   @db.VarChar(16)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  store         Store     @relation(fields: [storeId], references: [id])
  products      Product[]

  @@unique([storeId, code])
  @@index([storeId])
}

model CatalogOption {
  id            String                      @id @default(uuid())
  storeId       String
  key           String                      @db.VarChar(60)
  name          String                      @db.VarChar(80)
  displayOrder  Int                         @default(0)
  isActive      Boolean                     @default(true)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  store         Store                       @relation(fields: [storeId], references: [id])
  values        CatalogOptionValue[]
  categories    CategoryCatalogOption[]
  productValues ProductCatalogOptionValue[]

  @@unique([storeId, key])
  @@index([storeId])
  @@index([storeId, isActive, displayOrder])
}

model CatalogOptionValue {
  id            String                      @id @default(uuid())
  storeId       String
  optionId      String
  name          String                      @db.VarChar(100)
  value         String                      @db.VarChar(100)
  displayOrder  Int                         @default(0)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  store         Store                       @relation(fields: [storeId], references: [id])
  option        CatalogOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  productValues ProductCatalogOptionValue[]

  @@unique([optionId, value])
  @@index([storeId])
  @@index([optionId])
}

model CategoryCatalogOption {
  id           String        @id @default(uuid())
  storeId      String
  categoryId   String
  optionId     String
  displayOrder Int           @default(0)
  store        Store         @relation(fields: [storeId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  option       CatalogOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([categoryId, optionId])
  @@index([storeId])
  @@index([categoryId])
  @@index([optionId])
}

model ProductCatalogOptionValue {
  id            String             @id @default(uuid())
  storeId       String
  productId     String
  optionId      String
  optionValueId String
  store         Store              @relation(fields: [storeId], references: [id])
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  option        CatalogOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionValue   CatalogOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([productId, optionId])
  @@index([storeId])
  @@index([productId])
  @@index([optionId])
  @@index([optionValueId])
}

model Color {
  id         String    @id @default(uuid())
  storeId    String
  name       String
  value      String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  store      Store     @relation("StoreToColor", fields: [storeId], references: [id])
  products   Product[]

  @@unique([storeId, name])
  @@index([storeId])
  @@index([storeId, isArchived])
}

model Design {
  id         String    @id @default(uuid())
  storeId    String
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  store      Store     @relation("StoreToDesign", fields: [storeId], references: [id])
  products   Product[]

  @@unique([storeId, name])
  @@index([storeId])
  @@index([storeId, isArchived])
}

model ProductGroup {
  id                          String                       @id @default(uuid())
  storeId                     String
  store                       Store                        @relation("StoreToProductGroup", fields: [storeId], references: [id])
  name                        String
  slug                        String                       @default("")
  description                 String                       @db.Text
  brand                       String?                      @db.VarChar(120)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  products                    Product[]
  images                      Image[]
  offers                      OfferProductGroup[]
  catalogMigrationSuggestions CatalogMigrationSuggestion[]

  @@index([storeId])
  @@index([storeId, slug])
  @@index([createdAt])
  @@fulltext([name])
  @@fulltext([name, description])
}

model Product {
  id                          String                       @id @default(uuid())
  storeId                     String
  categoryId                  String
  name                        String
  slug                        String                       @default("")
  description                 String                       @db.Text
  stock                       Int                          @default(0)
  price                       Float                        @default(0)
  acqPrice                    Float?                       @default(0)
  /// Envío y otros gastos por unidad. Entra en el precio sugerido de Productos y en el piso de precio de Mercado Libre.
  transportationCost          Float?                       @default(0)
  isFeatured                  Boolean                      @default(false)
  isArchived                  Boolean                      @default(false)
  availableAt                 DateTime?
  soldCount                   Int                          @default(0)
  sizeId                      String
  shippingProfileId           String?
  colorId                     String
  designId                    String
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  sku                         String                       @unique
  brand                       String?                      @db.VarChar(120)
  gtin                        String?                      @db.VarChar(14)
  mpn                         String?                      @db.VarChar(70)
  hasNoProductIdentifier      Boolean                      @default(false)
  store                       Store                        @relation("StoreToProduct", fields: [storeId], references: [id])
  category                    Category                     @relation("CategoryToProduct", fields: [categoryId], references: [id])
  size                        Size                         @relation(fields: [sizeId], references: [id])
  shippingProfile             ShippingProfile?             @relation(fields: [shippingProfileId], references: [id])
  color                       Color                        @relation(fields: [colorId], references: [id])
  design                      Design                       @relation(fields: [designId], references: [id])
  images                      Image[]
  orderItems                  OrderItem[]
  reviews                     Review[]
  customerWishlistItems       CustomerWishlistItem[]
  supplierId                  String?
  supplier                    Supplier?                    @relation(fields: [supplierId], references: [id])
  productGroupId              String?
  productGroup                ProductGroup?                @relation(fields: [productGroupId], references: [id])
  offers                      OfferProduct[]
  inventoryMovements          InventoryMovement[]
  restockOrderItems           RestockOrderItem[]
  slugAliases                 ProductSlugAlias[]
  fairInventoryItems          FairEventInventoryItem[]
  fairCapsules                FairCapsule[]
  marketplaceListings         MarketplaceListing[]
  marketplaceOrderItems       MarketplaceOrderItem[]
  marketplaceOutboxEvents     MarketplaceOutboxEvent[]
  marketplaceQuestions        MarketplaceQuestion[]
  videos                      ProductVideo[]
  growthCampaignProducts      GrowthCampaignProduct[]
  catalogOptionValues         ProductCatalogOptionValue[]
  catalogMigrationSuggestions CatalogMigrationSuggestion[]
  homeContents                HomeContentProduct[]
  presales                    ProductPresale[]

  // -- CÁPSULAS SORPRESA --
  /// Lotes empacados de este producto cápsula (la cápsula es un producto normal).
  capsuleBatches    CapsuleBatch[]
  /// Veces que este producto se consumió empacando cápsulas.
  capsuleBatchItems CapsuleBatchItem[]
  /// Escalera de precio por cantidad. Sin filas, el precio es `price` a secas.
  priceTiers        ProductPriceTier[]

  // -- KIT / COMBO FIELDS --
  isKit         Boolean      @default(false)
  kitComponents ProductKit[] @relation("KitToComponent")
  componentIn   ProductKit[] @relation("ComponentToKit")

  // -- BI INTELLIGENCE --
  abcClassification String? // "A", "B", "C" or null

  @@index([storeId])
  @@index([slug])
  @@index([storeId, slug])
  @@index([categoryId])
  @@index([sizeId])
  @@index([shippingProfileId])
  @@index([colorId])
  @@index([designId])
  @@index([supplierId])
  @@index([storeId, isArchived, isFeatured])
  @@index([storeId, availableAt])
  @@index([storeId, soldCount])
  @@index([storeId, categoryId, isArchived])
  @@index([storeId, createdAt, isArchived])
  @@index([storeId, price, isArchived])
  @@index([storeId, stock, isArchived])
  @@index([storeId, gtin])
  @@index([id, storeId, stock, price])
  @@index([storeId, id, isArchived])
  @@index([id, stock])
  @@index([productGroupId])
  @@fulltext([name])
  @@fulltext([name, description])
}

enum ProductNamingEntityType {
  PRODUCT
  PRODUCT_GROUP
}

model ProductNamingChange {
  id           String                  @id @default(uuid())
  storeId      String
  entityType   ProductNamingEntityType
  entityId     String
  previousName String
  nextName     String
  batchId      String
  changedBy    String
  revertedAt   DateTime?
  revertedBy   String?
  createdAt    DateTime                @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, batchId])
  @@index([storeId, entityType, entityId, createdAt])
  @@index([storeId, revertedAt])
}

model ProductSlugAlias {
  id        String   @id @default(uuid())
  storeId   String
  productId String
  slug      String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([productId])
  @@index([storeId, createdAt])
}

model CategorySlugAlias {
  id         String   @id @default(uuid())
  storeId    String
  categoryId String
  slug       String
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([categoryId])
  @@index([storeId, createdAt])
}

model TypeSlugAlias {
  id        String   @id @default(uuid())
  storeId   String
  typeId    String
  slug      String
  createdAt DateTime @default(now())

  type  Type  @relation(fields: [typeId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([typeId])
  @@index([storeId, createdAt])
}

enum CatalogMigrationStatus {
  PREPARED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  APPLIED
}

enum CatalogMigrationSource {
  DETERMINISTIC
  AI
}

model CatalogMigrationSuggestion {
  id             String                 @id @default(uuid())
  storeId        String
  productId      String?
  productGroupId String?
  fingerprint    String                 @db.VarChar(191)
  status         CatalogMigrationStatus @default(PREPARED)
  source         CatalogMigrationSource @default(DETERMINISTIC)
  confidence     Float                  @default(0)
  payload        Json
  evidence       Json?
  model          String?                @db.VarChar(80)
  promptVersion  String?                @db.VarChar(40)
  appliedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  store          Store                  @relation(fields: [storeId], references: [id])
  product        Product?               @relation(fields: [productId], references: [id], onDelete: Cascade)
  productGroup   ProductGroup?          @relation(fields: [productGroupId], references: [id], onDelete: Cascade)

  @@unique([storeId, fingerprint])
  @@index([storeId, status])
  @@index([productId])
  @@index([productGroupId])
}

model ProductKit {
  id          String @id @default(uuid())
  kitId       String
  componentId String
  quantity    Int    @default(1)

  kit       Product @relation("KitToComponent", fields: [kitId], references: [id], onDelete: Cascade)
  component Product @relation("ComponentToKit", fields: [componentId], references: [id]) // No Cascade delete to protect components

  @@index([kitId])
  @@index([componentId])
}

/**
 * Un empaque de cápsulas: N cápsulas salen de una lista de productos de
 * origen. Es una transferencia de stock, igual que `VARIANT_CONVERSION`:
 * baja en los productos que entraron, sube en el producto cápsula. El costo
 * unitario se congela aquí porque el `acqPrice` de los orígenes cambia con el
 * tiempo y el margen de una venta vieja no debe moverse con él.
 */
model CapsuleBatch {
  id               String    @id @default(uuid())
  storeId          String
  /// El producto cápsula que este lote produce. Un producto normal y corriente.
  capsuleProductId String
  /// Cápsulas producidas. El stock del producto cápsula sube en esta cantidad.
  quantity         Int
  /// Costo por cápsula: suma de los orígenes / `quantity`, congelado al empacar.
  unitCost         Float
  /// Costo total del lote, congelado por la misma razón.
  totalCost        Float
  notes            String?   @db.Text
  createdBy        String?
  /// Fecha en que se deshizo el lote; mientras sea null el lote está vigente.
  unpackedAt       DateTime?
  unpackedBy       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store          Store              @relation(fields: [storeId], references: [id])
  capsuleProduct Product            @relation(fields: [capsuleProductId], references: [id])
  items          CapsuleBatchItem[]

  @@index([storeId, createdAt])
  @@index([capsuleProductId])
}

model CapsuleBatchItem {
  id        String @id @default(uuid())
  batchId   String
  productId String
  /// Unidades de este producto que entraron al lote completo (no por cápsula).
  quantity  Int
  /// `acqPrice` del producto al momento de empacar, congelado.
  unitCost  Float

  batch   CapsuleBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@unique([batchId, productId])
  @@index([productId])
}

/**
 * Escalera de precio por cantidad para cualquier producto. Gana el peldaño
 * con el `minQuantity` más alto que no pase de lo pedido. No hay `maxQuantity`:
 * el siguiente peldaño marca dónde termina el anterior.
 * Nunca se suma a una oferta: `lib/price-tiers.ts` se queda con el precio más
 * bajo de los dos, jamás con los dos aplicados.
 */
model ProductPriceTier {
  id          String   @id @default(uuid())
  storeId     String
  productId   String
  /// Desde cuántas unidades aplica este peldaño. El peldaño 1 es opcional.
  minQuantity Int
  /// Precio por unidad en este peldaño.
  unitPrice   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQuantity])
  @@index([storeId])
  @@index([productId, minQuantity])
}

model Supplier {
  id            String         @id @default(uuid())
  storeId       String
  name          String
  /// NIT o cédula, para cruzar con las facturas de proveedores (compras de impuestos).
  nit           String?        @db.VarChar(32)
  contactName   String?        @db.VarChar(120)
  phone         String?        @db.VarChar(32)
  email         String?        @db.VarChar(160)
  /// Días habituales entre pedir y recibir; avisa cuando un pedido se pasa de fecha.
  leadTimeDays  Int?
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  store         Store          @relation("StoreToSupplier", fields: [storeId], references: [id])
  products      Product[]
  restockOrders RestockOrder[]

  @@unique([storeId, name])
  @@index([storeId])
}

model Image {
  id             String        @id @default(uuid())
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productGroupId String?
  productGroup   ProductGroup? @relation(fields: [productGroupId], references: [id], onDelete: Cascade)
  url            String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
